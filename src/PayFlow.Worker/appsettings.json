{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "ConnectionStrings": {
    "PayFlow": ""
  },
  "Database": {
    "MigrateOnStartup": false,
    "EnableRowLevelSecurity": false
  },
  "Messaging": {
    "Transport": "RabbitMq",
    "OutboxBatchSize": 50,
    "OutboxPollInterval": "00:00:01",
    "MaxDeliveryRetries": 3,
    "RabbitMq": {
      "Host": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest",
      "VirtualHost": "/",
      "PrefetchCount": 16
    }
  },
  "Payments": {
    "RetryBaseDelay": "00:00:02",
    "RetryMaxDelay": "00:01:00",
    "ReconcileUnknownAfter": "00:00:10",
    "ReconcileProviderPendingAfter": "00:00:30",
    "ReconcileProcessingAfter": "00:02:00"
  },
  "MockProvider": {
    "WebhookSecret": "",
    "WebhookTargetUrl": "",
    "PendingResolutionDelay": "00:00:05",
    "EnableWebhookSimulator": true
  },
  "Worker": {
    "ReconciliationInterval": "00:00:15",
    "MockProviderInterval": "00:00:02"
  },
  "Auth": {
    "Jwt": {
      "SigningKey": "worker-does-not-issue-tokens-but-validates-config-0123456789"
    }
  }
}
