# Copy to .env (never commit .env). Values here are local-development defaults only.
POSTGRES_PASSWORD=payflow
PAYFLOW_APP_PASSWORD=payflow_app
JWT_SIGNING_KEY=local-dev-signing-key-change-me-0123456789abcdef
MOCK_WEBHOOK_SECRET=whsec_local_dev_mock_provider
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
GRAFANA_ADMIN_PASSWORD=admin

# Set to http://otel-collector:4317 when running with --profile observability
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional: platform administrator (tenant list, suspend/reactivate). Register this account yourself first.
PLATFORM_ADMIN_EMAIL=

# Optional: enables the read-only AI reporting assistant
ANTHROPIC_API_KEY=
